# Supabase — copy to .env.local and fill in. .env.local is gitignored.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx        # safe to ship in the client bundle (RLS enforced)
SUPABASE_SECRET_KEY=sb_secret_xxx                       # local admin/seed scripts ONLY — never imported under client/
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=YOUR_PROJECT

# Mapbox Directions API — real road-following route geometry only (map tiles stay OpenStreetMap).
# Get a free token at https://account.mapbox.com/ — copy to .env.local, never commit a real value.
VITE_MAPBOX_TOKEN=
